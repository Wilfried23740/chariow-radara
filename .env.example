# ── Serveur (API) ─────────────────────────────────────────────

# Connexion à PostgreSQL (en production : l'adresse fournie par Neon, avec ?sslmode=require)
DATABASE_URL=postgresql://utilisateur:mot_de_passe@localhost:5432/chariow_radar

# Authentification : générer un secret aléatoire d'au moins 32 caractères
BETTER_AUTH_SECRET=
# Adresse publique du site en production (https://…), l'API est jointe via /api
BETTER_AUTH_URL=http://localhost:3001

# Adresse du site : origines autorisées (plusieurs possibles, séparées par des virgules)
FRONTEND_URL=http://localhost:5173

# Production uniquement
# NODE_ENV=production

# Confirmation d'inscription par email (Resend, offre gratuite). Sans clé : pas de confirmation.
# RESEND_API_KEY=
# EMAIL_FROM=Chariow Radar <contact@votre-domaine.com>

# Anti-robots Cloudflare Turnstile (gratuit). Sans clé : pas de contrôle.
# TURNSTILE_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────────

# À renseigner seulement si l'API est sur un autre domaine que le site
# VITE_API_URL=

# Clé publique Turnstile (la clé secrète ci-dessus reste côté serveur)
# VITE_TURNSTILE_SITE_KEY=
